# Private brand configs stay untracked, but keep the directory itself (.gitkeep, see below) so the
# Docker `--mount=type=bind,source=deployment/configurations` in the webapp/maintenance builds finds
# its source dir even on a clean checkout (CI, vanilla build with BRAND="").
deployment/configurations/*

.vuepress/.cache/
.vuepress/.temp/
.vuepress/dist/
# Generated GraphQL API reference (SpectaQL), embedded into the VuePress site at /api/
.vuepress/public/api/


!.gitkeep
**/coverage

release/
*~
