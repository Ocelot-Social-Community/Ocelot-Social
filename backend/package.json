{
  "name": "ocelot-social-backend",
  "version": "3.18.4",
  "description": "GraphQL Backend for ocelot.social",
  "repository": "https://github.com/Ocelot-Social-Community/Ocelot-Social",
  "author": "ocelot.social Community",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "node build/src/",
    "build": "tsc && tsc-alias -f && ./scripts/build.copy.files.sh",
    "dev": "nodemon --exec tsx src/index.ts -e js,ts,gql",
    "dev:debug": "nodemon --exec node --inspect=0.0.0.0:9229 build/src/index.js -e js,ts,gql",
    "schema:print": "tsx src/graphql/print-schema.ts",
    "docs:api": "npm run schema:print && spectaql spectaql.yml",
    "lint": "eslint --max-warnings 0 .",
    "test": "cross-env NODE_ENV=test vitest run --coverage",
    "test:shard": "cross-env NODE_ENV=test VITEST_BLOB_REPORT=true vitest run --coverage --coverage.thresholds.lines=0 --coverage.thresholds.statements=0 --coverage.thresholds.branches=0 --coverage.thresholds.functions=0",
    "test:merge": "cross-env NODE_ENV=test vitest --merge-reports=coverage/blobs --coverage",
    "test:schema-contract": "cross-env NODE_ENV=test vitest run --coverage=false src/graphql/webappQueries.spec.ts src/graphql/webappPostFilters.spec.ts",
    "db:schema:check": "tsx src/db/schema/run-audit.ts check",
    "db:schema:apply": "tsx src/db/schema/run-audit.ts apply",
    "db:reset": "tsx src/db/reset.ts",
    "db:reset:withmigrations": "tsx src/db/reset-with-migrations.ts",
    "db:seed": "tsx --import ./src/graphql/gql-register.ts src/db/seed.ts",
    "db:data:owner": "tsx src/db/owner.ts",
    "db:data:promote-owner": "tsx src/db/promote-owner.ts",
    "db:data:roles": "tsx src/db/roles.ts",
    "db:data:badges": "tsx src/db/badges.ts",
    "db:data:branding": "tsx src/db/data-branding.ts",
    "db:data:categories": "tsx src/db/categories.ts",
    "db:migrate": "migrate --compiler 'ts:./src/db/compiler.cts' --migrations-dir ./src/db/migrations --store ./src/db/migrate/store.ts",
    "db:migrate:create": "migrate --compiler 'ts:./src/db/compiler.cts' --migrations-dir ./src/db/migrations --template-file ./src/db/migrate/template.ts --date-format 'yyyymmddHHmmss' create",
    "db:func:disable:notifications": "tsx src/db/disable-notifications.ts",
    "prod:migrate": "migrate --migrations-dir ./build/src/db/migrations --store ./build/src/db/migrate/store.js",
    "prod:db:data:branding": "node build/src/db/data-branding.js",
    "prod:db:data:categories": "node build/src/db/categories.js",
    "prod:db:data:owner": "node build/src/db/owner.js",
    "prod:db:data:promote-owner": "node build/src/db/promote-owner.js",
    "prod:db:data:roles": "node build/src/db/roles.js",
    "prod:db:func:disable:notifications": "node build/src/db/disable-notifications.js"
  },
  "dependencies": {
    "@apollo/server": "^4.11.3",
    "@aws-sdk/client-s3": "^3.1124.0",
    "@aws-sdk/lib-storage": "^3.1113.0",
    "@graphql-tools/load-files": "^7.0.0",
    "@graphql-tools/merge": "^9.2.3",
    "@graphql-tools/schema": "^10.0.0",
    "@ocelot-social/branding": "file:../packages/branding",
    "@sentry/node": "^10.71.0",
    "@types/mime-types": "^3.0.1",
    "ajv": "^8.20.0",
    "bcryptjs": "~3.0.3",
    "body-parser": "^2.3.0",
    "cheerio": "~1.2.0",
    "cross-env": "~10.1.0",
    "dataloader": "^2.2.3",
    "dotenv": "~17.0.1",
    "email-templates": "^13.0.1",
    "express": "^5.2.1",
    "graphql": "^16.14.2",
    "graphql-middleware": "~6.1.35",
    "graphql-redis-subscriptions": "^2.7.0",
    "graphql-shield": "^7.6.5",
    "graphql-subscriptions": "^2.0.0",
    "graphql-upload": "^13.0.0",
    "graphql-ws": "^5.16.2",
    "helmet": "~8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "~9.0.3",
    "languagedetect": "^2.0.0",
    "linkify-html": "^4.3.3",
    "linkifyjs": "^4.3.3",
    "livekit-server-sdk": "^2.18.0",
    "lodash": "~4.18.1",
    "metascraper": "^5.50.0",
    "metascraper-author": "^5.50.0",
    "metascraper-date": "^5.50.0",
    "metascraper-description": "^5.50.0",
    "metascraper-image": "^5.50.0",
    "metascraper-lang": "^5.50.0",
    "metascraper-lang-detector": "^4.10.2",
    "metascraper-logo": "^5.50.0",
    "metascraper-publisher": "^5.50.0",
    "metascraper-soundcloud": "^5.34.4",
    "metascraper-title": "^5.50.0",
    "metascraper-url": "^5.50.0",
    "metascraper-video": "^5.50.0",
    "metascraper-youtube": "^5.50.0",
    "migrate": "^2.1.0",
    "mime-types": "^3.0.2",
    "minimatch": "^10.2.6",
    "mustache": "^4.2.0",
    "neo4j-driver": "^4.4.11",
    "node-fetch": "^2.7.0",
    "nodemailer": "^9.0.5",
    "nodemailer-html-to-text": "^3.2.0",
    "preview-email": "^3.3.0",
    "pug": "^3.0.4",
    "sanitize-html": "~2.17.7",
    "slugify": "^1.6.9",
    "subscriptions-transport-ws": "^0.11.0",
    "trunc-html": "~1.1.2",
    "tslog": "^4.10.2",
    "uuid": "^14.0.2",
    "validator": "^13.15.35",
    "ws": "^8.21.3",
    "xregexp": "^5.1.2"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@types/debug": "^4.1.13",
    "@types/email-templates": "^10.0.4",
    "@types/jsonwebtoken": "~9.0.10",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.1.1",
    "@types/request": "^2.48.13",
    "@types/slug": "^5.0.9",
    "@types/validator": "^13.15.10",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "eslint-config-it4c": "^0.13.2",
    "nodemon": "~3.1.14",
    "prettier": "^3.9.6",
    "rosie": "^2.1.1",
    "spectaql": "^3.0.9",
    "tsc-alias": "^1.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "metascraper-lang-detector": {
      "metascraper": "$metascraper"
    },
    "graphql-redis-subscriptions": {
      "ioredis": "$ioredis"
    },
    "fs-capacitor": "^6.2.0",
    "strip-ansi": "6.0.1",
    "string-width": "4.2.0",
    "wrap-ansi": "7.0.0",
    "jwa": "^2.0.1",
    "@types/express": "4.17.25",
    "re2": "~1.24.1"
  },
  "engines": {
    "node": ">=25.5.0"
  },
  "allowScripts": {
    "re2@1.24.1": true
  }
}
