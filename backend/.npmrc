# `@ocelot-social/branding` is a `file:../packages/branding` dependency. npm's DEFAULT for `file:` is a
# symlink into the source tree; yarn 1 copied the directory instead, and every Dockerfile stage here is
# built on the copy semantics (`COPY --from=branding-runtime` puts the package at /packages/branding, and
# the runtime image resolves it from there without the webapp/backend sources being present).
#
# `install-links=true` restores the copy — with one deliberate improvement over yarn: npm packs the
# dependency, so `"files": ["dist", "scripts"]` is honoured and the package's src/ no longer rides along.
# Its own dependencies are hoisted into this project's tree from the registry and are therefore pinned in
# package-lock.json, instead of being whatever happened to sit in the package's own node_modules.
#
# This MUST live in a committed .npmrc rather than on a command line: the lockfile shape differs between
# the two modes (`"link": true` + a `../packages/branding` entry vs. `"resolved": "file:..."`), so a
# mismatch is not a subtle drift — `npm ci` exits 1 and names the flag.
install-links=true
