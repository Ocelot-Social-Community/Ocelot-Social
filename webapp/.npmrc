# `@ocelot-social/branding` and `@ocelot-social/ui` are `file:../packages/*` dependencies. npm's DEFAULT
# for `file:` is a symlink into the source tree; yarn 1 copied the directory instead, and the Dockerfile
# stages here are built on the copy semantics (`COPY --from=ui-runtime` / `--from=branding-runtime` put
# the packages at /packages/*, and the runtime image resolves them from there).
#
# `install-links=true` restores the copy, and fixes the waste the Dockerfile documents at length: npm
# packs the dependency, so `"files": ["dist"]` is honoured. yarn copied each package VERBATIM — src/,
# examples/ and its whole node_modules — which is what put a SECOND Vue 3 (from @ocelot-social/ui's dev
# tree) into this Vue 2 app's node_modules, and what the `npm prune --omit=dev --omit=optional &&
# rm -rf src examples` dance in the Dockerfile exists to undo.
#
# This MUST live in a committed .npmrc rather than on a command line: the lockfile shape differs between
# the two modes, so a mismatch is not a subtle drift — `npm ci` exits 1 and names the flag.
install-links=true

# Related, and worth knowing before you bump `vue-demi`: package.json carries a version-pinned
# `allowScripts` entry for it (`vue-demi@0.14.10`). npm 12 blocks install scripts by default, and
# vue-demi's postinstall is what switches the package to the Vue 2 build — without it `isVue2` comes
# out false and every Jest suite fails in test/vueDemiSetup.js. Its postinstall is wrapped in
# try/catch, so a block leaves no error of its own; the pin is what makes a new version stop and be
# looked at instead of inheriting the permission. After bumping, re-approve in the same commit:
#   npm install-scripts approve vue-demi --allow-scripts-pin
