{
  "name": "ocelot-social-webapp",
  "version": "3.18.4",
  "description": "ocelot.social Frontend",
  "repository": "https://github.com/Ocelot-Social-Community/Ocelot-Social",
  "author": "ocelot.social Community",
  "license": "MIT",
  "private": false,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--openssl-legacy-provider nuxt",
    "storybook": "cross-env NODE_OPTIONS=--openssl-legacy-provider storybook dev -p 3002 -c storybook/ --host 0.0.0.0",
    "build-storybook": "node scripts/fix-storybook-webpack.js && cross-env NODE_OPTIONS=--openssl-legacy-provider storybook build -c storybook/",
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider nuxt build",
    "start": "cross-env NODE_OPTIONS=--openssl-legacy-provider nuxt-start",
    "generate": "cross-env NODE_OPTIONS=--openssl-legacy-provider nuxt generate",
    "lint": "eslint --ext .js,.vue .",
    "locales": "../scripts/translations/missing-keys.sh && ../scripts/translations/sort.sh",
    "locales:normalize": "../scripts/translations/normalize.sh",
    "precommit": "npm run lint",
    "test": "cross-env NODE_ENV=test jest --coverage",
    "test:unit:update": "npm test -- --updateSnapshot",
    "test:unit:debug": "node --inspect-brk ./node_modules/jest/bin/jest.js --no-cache --runInBand  --forceExit --detectOpenHandles",
    "test:visual": "playwright test",
    "test:visual:docker": "npm run build:file-packages && npm run build-storybook && docker compose -f ../docker-compose.visual.yml run --rm webapp-visual-update-changed",
    "postinstall": "node scripts/fix-vue2-jest.js && node scripts/fix-v-mapbox.js",
    "lint:css-tokens": "node scripts/check-css-tokens.js",
    "build:file-packages": "([ -d ../packages/branding/node_modules ] || npm --prefix ../packages/branding ci) && npm --prefix ../packages/branding run build && ([ -d ../packages/ui/node_modules ] || npm --prefix ../packages/ui ci) && npm --prefix ../packages/ui run build && rm -rf node_modules/@ocelot-social/branding node_modules/@ocelot-social/ui node_modules/.package-lock.json && npm install"
  },
  "dependencies": {
    "@mapbox/mapbox-gl-geocoder": "^5.1.2",
    "@nuxtjs/apollo": "^4.0.0-rc19",
    "@nuxtjs/axios": "~5.13.6",
    "@nuxtjs/dotenv": "~1.4.2",
    "@nuxtjs/pwa": "^3.0.0-beta.20",
    "@nuxtjs/sentry": "^4.0.0",
    "@ocelot-social/branding": "file:../packages/branding",
    "@ocelot-social/ui": "file:../packages/ui",
    "accounting": "~0.4.1",
    "apollo-cache-inmemory": "~1.6.6",
    "apollo-client": "~2.6.10",
    "async-validator": "^3.2.4",
    "cookie-universal-nuxt": "~2.2.2",
    "cropperjs": "^1.6.2",
    "cross-env": "~10.1.0",
    "date-fns": "2.22.1",
    "dotenv": "8.2.0",
    "graphql": "14.7.0",
    "graphql-tag": "2.10.1",
    "intersection-observer": "^0.12.2",
    "linkify-it": "~5.0.2",
    "livekit-client": "^2.22.0",
    "lodash": "4.17.21",
    "mapbox-gl": "1.13.3",
    "nuxt-dropzone": "^1.0.4",
    "nuxt-env": "~0.1.0",
    "nuxt-start": "^2.18.1",
    "prosemirror-model": "1.9.1",
    "prosemirror-state": "1.3.3",
    "tippy.js": "^4.3.5",
    "tiptap": "~1.26.6",
    "tiptap-extensions": "~1.28.8",
    "trunc-html": "^1.1.2",
    "v-mapbox": "^1.11.2",
    "v-tooltip": "~2.1.3",
    "validator": "^13.15.35",
    "vue": "~2.7.16",
    "vue-advanced-chat": "^2.1.2",
    "vue-apollo": "3.0.2",
    "vue-cli-plugin-apollo": "^0.21.3",
    "vue-demi": "^0.14.10",
    "vue-infinite-loading": "^2.4.5",
    "vue-izitoast": "^1.2.1",
    "vue-meta": "2.4.0",
    "vue-observe-visibility": "^1.0.0",
    "vue-router": "3.6.5",
    "vue-scrollto": "^2.20.0",
    "vue-sweetalert-icons": "~4.3.1",
    "vue-template-compiler": "^2.7.16",
    "vue-virtual-scroller": "^1.1.2",
    "vue2-datepicker": "^3.11.1",
    "vuex": "3.6.2",
    "vuex-i18n": "~1.13.1",
    "xregexp": "^5.1.2",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.8",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/preset-env": "^7.25.8",
    "@csstools/postcss-global-data": "^4.0.0",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "~1.61.1",
    "@storybook/addon-a11y": "7.6.24",
    "@storybook/addon-actions": "7.6.24",
    "@storybook/vue": "7.6.24",
    "@storybook/vue-webpack5": "7.6.24",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/vue": "5",
    "@vue/test-utils": "1.3.4",
    "@vue/vue2-jest": "29",
    "babel-eslint": "~10.1.0",
    "babel-jest": "30.4",
    "babel-loader": "~8.1.0",
    "babel-plugin-require-context-hook": "^1.0.0",
    "core-js": "~2.6.10",
    "css-loader": "^4.2.0",
    "eslint": "^7.28.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-config-standard": "~15.0.1",
    "eslint-plugin-import": "~2.32.0",
    "eslint-plugin-jest": "~29.16.5",
    "eslint-plugin-node": "~11.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "~7.3.0",
    "eslint-plugin-standard": "~5.0.0",
    "eslint-plugin-vue": "~9.33.0",
    "flush-promises": "^1.0.2",
    "http-server": "14.1.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "29.7",
    "jest-environment-jsdom": "^29.7.0",
    "jest-serializer-vue": "^3.1.0",
    "mutation-observer": "^1.0.3",
    "nuxt": "^2.18.1",
    "prettier": "~3.9.6",
    "raw-loader": "^4.0.2",
    "storybook": "7.6.24",
    "storybook-design-token": "^3.3.0",
    "style-loader": "~0.23.1",
    "vue-loader": "^15.11.1",
    "vue-svg-loader": "~0.16.0",
    "webpack": "4.47.0"
  },
  "overrides": {
    "graphql": "$graphql",
    "vue": "$vue",
    "vue-server-renderer": "2.7.16",
    "v-mapbox": {
      "mapbox-gl": "$mapbox-gl"
    },
    "@vue/vue2-jest": {
      "babel-jest": "$babel-jest"
    },
    "eslint-plugin-prettier": {
      "eslint": "$eslint"
    },
    "storybook-design-token": {
      "@storybook/blocks": "7.6.24",
      "@storybook/components": "7.6.24",
      "@storybook/core-events": "7.6.24",
      "@storybook/manager-api": "7.6.24",
      "@storybook/preview-api": "7.6.24",
      "@storybook/theming": "7.6.24",
      "@storybook/types": "7.6.24",
      "storybook": "7.6.24"
    },
    "orderedmap": "1.1.0",
    "prosemirror-commands": "1.1.3",
    "prosemirror-keymap": "1.1.3",
    "prosemirror-model": "1.9.1",
    "prosemirror-schema-list": "1.1.2",
    "prosemirror-state": "1.3.3",
    "prosemirror-tables": "1.0.0",
    "prosemirror-transform": "1.2.4",
    "prosemirror-view": "1.14.6",
    "w3c-keyname": "2.2.1",
    "tiptap-commands": "1.12.7",
    "tiptap-utils": "1.8.4"
  },
  "allowScripts": {
    "vue-demi@0.14.10": true
  }
}
