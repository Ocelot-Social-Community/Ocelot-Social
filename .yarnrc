# The VuePress docs toolchain lives in this repo's package.json (it must, because
# VuePress resolves `vuepress`/`vuepress-theme-hope` relative to the repo root — see
# .vuepress/Dockerfile), alongside the yarn-managed e2e/Cypress deps.
# `vuepress-plugin-search-pro` declares `engines: { yarn: ">=2" }`, which makes
# yarn 1 abort the root install with "Found incompatible module". The docs are built
# with npm (not yarn), so this engine field is irrelevant here — relax the check.
ignore-engines true
