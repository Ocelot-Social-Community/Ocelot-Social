# `vuep` is pinned to a fork branch (git+https://github.com/visualjerk/vuep.git#fix-iframe-firefox)
# because upstream never merged the Firefox iframe fix. npm 12 defaults `allow-git` to `none` and
# refuses such dependencies with EALLOWGIT; yarn 1 fetched them without asking.
#
# `root`, not `all`: it permits only the git dependencies declared in THIS package.json — which is
# exactly vuep — while a transitive git dependency pulled in by some future update still has to be
# opted into deliberately. The accepted values are `all`, `none` and `root`; `true` is not one of
# them, however plausible it looks.
#
# `root` needs npm >= 11.13.0: up to 11.12.x npm rejects vuep as a "non-root" git package (EALLOWGIT)
# even though package.json declares it directly. Alpine 3.24's `npm` package ships 11.12.1.
allow-git=root
