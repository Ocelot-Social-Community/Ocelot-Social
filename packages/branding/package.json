{
  "name": "@ocelot-social/branding",
  "version": "0.0.1",
  "description": "Shared branding override schema, framework defaults and resolver — consumed by both backend and webapp so brand-tunable constants (group limits, registration lengths, metadata, logo paths, menu, …) cannot drift between the two. Authored in TypeScript, built to dist/ (CommonJS + .d.ts).",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ocelot-brand-archive": "scripts/build-brand-archive.ts"
  },
  "files": [
    "dist",
    "scripts"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "echo '{ \"type\": \"commonjs\" }' > dist/package.json",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.ts",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-functions=95 --test-coverage-branches=82 test/*.test.ts",
    "check": "npm run build && npm run lint && npm run typecheck && npm run test:coverage",
    "build:dev-brandings": "node scripts/build-dev-brandings.ts"
  },
  "devDependencies": {
    "@types/node": "^18.18.9",
    "eslint": "^9.27.0",
    "eslint-config-it4c": "^0.12.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.63.0"
  },
  "dependencies": {
    "nanotar": "^0.3.0"
  }
}
